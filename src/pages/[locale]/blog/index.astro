---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import BlogList from "../../../islands/BlogList.tsx";
import { ALL_LANGS, createT } from "../../../lib/i18n";
import type { Lang } from "../../../lib/i18n";

export function getStaticPaths() {
  return ALL_LANGS.filter((l) => l !== "en").map((locale) => ({
    params: { locale },
  }));
}

const { locale } = Astro.params as { locale: Lang };
const t = createT(locale);
---

<BaseLayout title={t("blog.title")} description="" locale={locale} wide>
  <BlogList client:only="react" />
</BaseLayout>

---
import fs from "node:fs";
import path from "node:path";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { ALL_LANGS, createT } from "../../../lib/i18n";
import type { Lang } from "../../../lib/i18n";

export function getStaticPaths() {
  return ALL_LANGS.filter((l) => l !== "en").map((locale) => ({
    params: { locale },
  }));
}

const { locale } = Astro.params as { locale: Lang };
const t = createT(locale);

let articles: Record<string, unknown>[] = [];
const indexPath = path.resolve(`public/articles/${locale}/index.json`);
if (fs.existsSync(indexPath)) {
  articles = JSON.parse(fs.readFileSync(indexPath, "utf-8"));
} else {
  const enIndex = path.resolve("public/articles/en/index.json");
  if (fs.existsSync(enIndex)) {
    articles = JSON.parse(fs.readFileSync(enIndex, "utf-8"));
  }
}
---

<BaseLayout title={t("blog.title")} description="" locale={locale}>
  <h1>{t("blog.title")}</h1>
  <ul>
    {articles.map((article) => (
      <li>
        <a href={`/${locale}/blog/${article.slug}`}>
          <h2>{String(article.title || "")}</h2>
          {article.date && <time datetime={String(article.date)}>{String(article.date)}</time>}
          {article.description && <p>{String(article.description)}</p>}
        </a>
      </li>
    ))}
  </ul>
</BaseLayout>

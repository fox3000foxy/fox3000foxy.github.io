---
import fs from "node:fs";
import path from "node:path";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Article from "../../../islands/Article.tsx";
import { ALL_LANGS } from "../../../lib/i18n";
import type { Lang } from "../../../lib/i18n";

export async function getStaticPaths() {
  const paths: { params: { locale: string; slug: string } }[] = [];
  for (const locale of ALL_LANGS) {
    if (locale === "en") continue;
    const indexPath = path.resolve(`public/articles/${locale}/index.json`);
    if (!fs.existsSync(indexPath)) continue;
    const index = JSON.parse(fs.readFileSync(indexPath, "utf-8"));
    for (const entry of index) {
      paths.push({ params: { locale, slug: entry.slug } });
    }
  }
  return paths;
}

const { locale } = Astro.params as { locale: Lang };
---

<BaseLayout title="Article" description="" locale={locale} wide>
  <Article client:only="react" />
</BaseLayout>

---
import fs from "node:fs";
import path from "node:path";
import { renderMarkdown } from "../../lib/markdown";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { ALL_LANGS, createT } from "../../lib/i18n";
import type { Lang } from "../../lib/i18n";

export function getStaticPaths() {
  return ALL_LANGS.filter((l) => l !== "en").map((locale) => ({
    params: { locale },
  }));
}

const { locale } = Astro.params as { locale: Lang };
const t = createT(locale);

let html = "";
const mdPath = path.resolve(`public/404.${locale}.md`);
const fallbackPath = path.resolve("public/404.md");
const filePath = fs.existsSync(mdPath) ? mdPath : fallbackPath;
if (fs.existsSync(filePath)) {
  html = renderMarkdown(fs.readFileSync(filePath, "utf-8"));
}
---

<BaseLayout title="404" description="Page not found" locale={locale}>
  {html ? (
    <article set:html={html} />
  ) : (
    <div>
      <h2>404</h2>
      <p>{t("notFound.title")}</p>
      <p><a href={`/${locale === "en" ? "" : locale}`}>{t("notFound.return")}</a></p>
    </div>
  )}
</BaseLayout>

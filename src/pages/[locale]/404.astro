---
import BaseLayout from "../../layouts/BaseLayout.astro";
import NotFound from "../../islands/NotFound.tsx";
import { ALL_LANGS } from "../../lib/i18n";
import type { Lang } from "../../lib/i18n";

export function getStaticPaths() {
  return ALL_LANGS.filter((l) => l !== "en").map((locale) => ({
    params: { locale },
  }));
}

const { locale } = Astro.params as { locale: Lang };
---

<BaseLayout title="404" description="Page not found" locale={locale} wide>
  <NotFound client:only="react" />
</BaseLayout>

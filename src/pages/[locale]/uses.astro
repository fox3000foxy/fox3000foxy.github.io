---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Uses from "../../islands/Uses.tsx";
import { ALL_LANGS } from "../../lib/i18n";
import type { Lang } from "../../lib/i18n";

export function getStaticPaths() {
  return ALL_LANGS.filter((l) => l !== "en").map((locale) => ({
    params: { locale },
  }));
}

const { locale } = Astro.params as { locale: Lang };
---

<BaseLayout title="Uses" description="" locale={locale} wide>
  <Uses client:only="react" />
</BaseLayout>

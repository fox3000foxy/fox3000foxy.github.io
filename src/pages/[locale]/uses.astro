---
import fs from "node:fs";
import path from "node:path";
import { renderMarkdown } from "../../lib/markdown";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { ALL_LANGS } from "../../lib/i18n";
import type { Lang } from "../../lib/i18n";

export function getStaticPaths() {
  return ALL_LANGS.filter((l) => l !== "en").map((locale) => ({
    params: { locale },
  }));
}

const { locale } = Astro.params as { locale: Lang };

const mdPath = path.resolve(`public/uses.${locale}.md`);
const fallbackPath = path.resolve("public/uses.md");
const filePath = fs.existsSync(mdPath) ? mdPath : fallbackPath;
const content = fs.readFileSync(filePath, "utf-8");
const html = renderMarkdown(content);
---

<BaseLayout title="Uses" description="" locale={locale}>
  <article set:html={html} />
</BaseLayout>

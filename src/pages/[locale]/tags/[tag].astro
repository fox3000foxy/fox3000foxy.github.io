---
import fs from "node:fs";
import path from "node:path";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import TagIndex from "../../../islands/TagIndex.tsx";
import { ALL_LANGS } from "../../../lib/i18n";
import type { Lang } from "../../../lib/i18n";

export async function getStaticPaths() {
  const paths: { params: { locale: string; tag: string } }[] = [];
  for (const locale of ALL_LANGS) {
    if (locale === "en") continue;
    const indexPath = path.resolve(`public/articles/${locale}/index.json`);
    if (!fs.existsSync(indexPath)) continue;
    const index = JSON.parse(fs.readFileSync(indexPath, "utf-8"));
    const tags = new Set<string>();
    for (const entry of index) {
      if (entry.tags) {
        for (const tag of entry.tags) {
          tags.add(tag);
        }
      }
    }
    for (const tag of tags) {
      paths.push({ params: { locale, tag } });
    }
  }
  return paths;
}

const { locale } = Astro.params as { locale: Lang };
---

<BaseLayout title="Tag" description="" locale={locale} wide>
  <TagIndex client:only="react" />
</BaseLayout>

---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import TagsIndex from "../../../islands/TagsIndex.tsx";
import { ALL_LANGS } from "../../../lib/i18n";
import type { Lang } from "../../../lib/i18n";

export function getStaticPaths() {
  return ALL_LANGS.filter((l) => l !== "en").map((locale) => ({
    params: { locale },
  }));
}

const { locale } = Astro.params as { locale: Lang };
---

<BaseLayout title="Tags" description="" locale={locale} wide>
  <TagsIndex client:only="react" />
</BaseLayout>

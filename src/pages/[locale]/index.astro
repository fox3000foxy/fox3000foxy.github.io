---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Home from "../../islands/Home.tsx";
import { ALL_LANGS } from "../../lib/i18n";
import type { Lang } from "../../lib/i18n";

export function getStaticPaths() {
  return ALL_LANGS.filter((l) => l !== "en").map((locale) => ({
    params: { locale },
  }));
}

const { locale } = Astro.params as { locale: Lang };
const title = locale === "fr" ? "Accueil" : "Home";
const desc = locale === "fr" ? "Blog de Fox3000foxy" : "Fox3000foxy's blog about web development, automation, and open-source";
---

<BaseLayout title={title} description={desc} locale={locale} wide>
  <Home client:only="react" />
</BaseLayout>

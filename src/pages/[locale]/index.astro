---
import fs from "node:fs";
import path from "node:path";
import { renderMarkdown } from "../../lib/markdown";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { ALL_LANGS } from "../../lib/i18n";
import type { Lang } from "../../lib/i18n";

export function getStaticPaths() {
  return ALL_LANGS.filter((l) => l !== "en").map((locale) => ({
    params: { locale },
  }));
}

const { locale } = Astro.params as { locale: Lang };

const homePath = path.resolve(`public/home.${locale}.md`);
const fallbackPath = path.resolve("public/home.md");
const mdPath = fs.existsSync(homePath) ? homePath : fallbackPath;
const content = fs.readFileSync(mdPath, "utf-8");
const html = renderMarkdown(content);
---

<BaseLayout title="Home" description="" locale={locale}>
  <article class="home" set:html={html} />
</BaseLayout>

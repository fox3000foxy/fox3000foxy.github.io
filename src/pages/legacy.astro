---
import fs from "node:fs";
import path from "node:path";
import BaseLayout from "../layouts/BaseLayout.astro";
import { ALL_LANGS } from "../lib/i18n";
import { renderMarkdown } from "../lib/markdown";
import { breadcrumbJsonLd } from "../lib/schema";

const allContent: Record<string, string> = {};
for (const lang of ALL_LANGS) {
  const filePath = path.resolve(`public/legacy.${lang}.md`);
  if (fs.existsSync(filePath)) {
    allContent[lang] = renderMarkdown(fs.readFileSync(filePath, "utf-8"));
  }
}
if (!allContent["en"]) {
  allContent["en"] = renderMarkdown(fs.readFileSync(path.resolve("public/legacy.md"), "utf-8"));
}
const en = allContent["en"] ?? "";
for (const lang of ALL_LANGS) {
  if (!allContent[lang]) allContent[lang] = en;
}

const legacyJsonLd = breadcrumbJsonLd([
  { name: "Home", url: "/" },
  { name: "Portfolio", url: "/legacy" },
]);
---

<BaseLayout title="Portfolio" description="Legacy portfolio — projects, contributions, and open-source work by Fox3000foxy" extraHead={`<script type="application/ld+json">${legacyJsonLd}</script>`}>
  {ALL_LANGS.map((l) => (
    <article class="home lang-content" data-lang={l} set:html={allContent[l]} />
  ))}
</BaseLayout>

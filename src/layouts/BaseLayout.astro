---
import "../styles/themes.css";
import "../styles/index.css";
import "../styles/App.css";
import "highlight.js/styles/github-dark.min.css";
import { SITE_URL, SITE_DESCRIPTION } from "../config";
import { ALL_LANGS, RTLLangs } from "../lib/i18n";
import type { Lang } from "../lib/i18n";
import { ogLocale } from "../lib/schema";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

export interface Props {
  title: string;
  description?: string;
  image?: string;
  canonical?: string;
  locale?: Lang;
  extraHead?: string;
  wide?: boolean;
}

const { title, description, image, canonical, locale, extraHead, wide } = Astro.props;
const lang = locale || "en";
const canonicalUrl = `${SITE_URL}${canonical || Astro.url.pathname}`;
const ogImage = image || `${SITE_URL}/og/home.png`;
const metaDesc = description || SITE_DESCRIPTION;
const dir = RTLLangs.has(lang) ? "rtl" : "ltr";
const localeStr = ogLocale(lang);

const hreflangLinks = ALL_LANGS.map((l) =>
  `<link rel="alternate" hreflang="${l}" href="${SITE_URL}${Astro.url.pathname}" />`
).join("\n") + `\n<link rel="alternate" hreflang="x-default" href="${SITE_URL}${Astro.url.pathname}" />`;
---
<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <!--
      WordPress 5.9.3 | Theme: fox3k v2.4.1 | Site: fox3000foxy.com
      Generated by WordPress on Apache/2.4.52 (Ubuntu)
    -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Fox's Blog</title>
    <meta name="description" content={metaDesc} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDesc} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Fox's Blog" />
    <meta property="og:locale" content={localeStr} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@fox3000foxy" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={metaDesc} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="author" content="Fox3000foxy" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    <meta name="generator" content="WordPress 5.9.3" />
    <link rel="canonical" href={canonicalUrl} />

    <link rel="alternate" type="application/rss+xml" title="Fox's Blog RSS Feed" href="/feed.xml" />
    <link rel="webmention" href="https://webmention.io/fox3000foxy/webmention" />
    <link rel="pingback" href="/xmlrpc.php" />
    <link rel="authorization_endpoint" href="https://indieauth.com/auth" />
    <link rel="token_endpoint" href="https://tokens.indieauth.com/token" />
    <link rel="me" href="https://github.com/fox3000foxy" />

    <link rel="apple-touch-icon" sizes="57x57" href="/icons/apple-icon-57x57.png" />
    <link rel="apple-touch-icon" sizes="60x60" href="/icons/apple-icon-60x60.png" />
    <link rel="apple-touch-icon" sizes="72x72" href="/icons/apple-icon-72x72.png" />
    <link rel="apple-touch-icon" sizes="76x76" href="/icons/apple-icon-76x76.png" />
    <link rel="apple-touch-icon" sizes="114x114" href="/icons/apple-icon-114x114.png" />
    <link rel="apple-touch-icon" sizes="120x120" href="/icons/apple-icon-120x120.png" />
    <link rel="apple-touch-icon" sizes="144x144" href="/icons/apple-icon-144x144.png" />
    <link rel="apple-touch-icon" sizes="152x152" href="/icons/apple-icon-152x152.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/icons/apple-icon-180x180.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icons/android-icon-192x192.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="96x96" href="/icons/favicon-96x96.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/icons/favicon-16x16.png" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="msapplication-TileColor" content="#ffffff" />
    <meta name="theme-color" content="#000000" />

    {extraHead !== undefined && <Fragment set:html={extraHead} />}
    <Fragment set:html={hreflangLinks} />

    <script data-goatcounter="https://fox3000foxy.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>
    <script>if('serviceWorker' in navigator)navigator.serviceWorker.register('/sw.js');</script>
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    <script set:html={`(function(){var t=localStorage.getItem('theme');if(t==='light'||(!t&&window.matchMedia('(prefers-color-scheme:light)').matches))document.documentElement.classList.add('light');var l=localStorage.getItem('fox-blog-lang');if(!l){var p=navigator.languages||[navigator.language],c=${JSON.stringify(["en","fr","zh","ja","ko","tr","it","de","ru","es","pt","id","hi","ar","vi","th"])};for(var i=0;i<p.length;i++){var x=p[i].split('-')[0];if(c.indexOf(x)!==-1){l=x;break}}}if(l&&l!=='en')document.documentElement.dataset.lang=l;var rtl=${JSON.stringify(Array.from(RTLLangs))};document.documentElement.dir=(l&&rtl.indexOf(l)!==-1)?'rtl':'ltr'})()`} />
  </head>
  <body>
    <input type="checkbox" id="theme-toggle" class="theme-checkbox" aria-label="Toggle theme" />
    <div id="root">
      <Header locale={lang} />
      <main id="main-content" class={wide ? "" : "article-content"} style={wide ? "" : "max-width:700px;margin:0 auto;"}>
        <slot />
      </main>
      <Footer />
    </div>

    <script>
    (function(){
      var t = localStorage.getItem("theme");
      var cb = document.getElementById("theme-toggle");
      if (cb instanceof HTMLInputElement) {
        if (t === "light") cb.checked = true;
        var meta = document.querySelector('meta[name="theme-color"]');
        function updateMeta(checked: boolean) {
          if (meta) meta.setAttribute("content", checked ? "#f8f9fa" : "#000000");
        }
        updateMeta(cb.checked);
        cb.addEventListener("change", function() {
          var el = document.getElementById("theme-toggle");
          var checked = el instanceof HTMLInputElement && el.checked;
          localStorage.setItem("theme", checked ? "light" : "dark");
          updateMeta(checked);
        });
      }
    })();
    </script>
  </body>
</html>

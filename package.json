{
  "name": "blog",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "create-cname": "echo fox3000foxy.com > dist/CNAME",
    "generate-audio": "python3 scripts/generate-audio.py",
    "build-indexes": "bun run scripts/generate-index.ts",
    "compile-aiml": "bun run scripts/compile-aiml.ts",
    "build": "bun run scripts/generate-index.ts && astro build && touch dist/.nojekyll && unzip -o www.zip -d dist/; bun run scripts/generate-og-pages.ts && bun run scripts/inject-decoy-sitemap.ts",
    "preview": "astro preview",
    "format": "bunx --bun @biomejs/biome format --write ./src",
    "check": "bunx --bun @biomejs/biome check ./src",
    "lint": "bunx --bun @biomejs/biome lint ./src",
    "deploy-page": "bun run build && bun run create-cname && cp dist/index.html dist/404.html && bunx gh-pages -d dist --nojekyll",
    "lint:write": "bunx --bun @biomejs/biome lint --write ./src"
  },
  "dependencies": {
    "@astrojs/preact": "^6.0.6",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@resvg/resvg-js": "^2.6.2",
    "@tiptap/extension-image": "^3.31.4",
    "@tiptap/extension-link": "^3.31.4",
    "@tiptap/extension-placeholder": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "astro": "^7.3.6",
    "glob": "^13.0.6",
    "highlight.js": "^11.12.0",
    "marked": "^18.1.0",
    "marked-highlight": "^2.2.4",
    "puppeteer": "^25.12.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/turndown": "^5.0.6",
    "typescript": "~7.0.2"
  },
  "overrides": {
    "picomatch": "4.0.4",
    "dompurify": "3.4.12"
  }
}

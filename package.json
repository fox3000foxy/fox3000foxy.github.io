{
  "name": "blog",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "create-cname": "echo fox3000foxy.com > dist/CNAME",
    "build": "bun run scripts/generate-index.ts && tsc -b && vite build && bun run scripts/generate-rss.ts && bun run scripts/generate-sitemap.ts && bun run scripts/generate-news-sitemap.ts && bun run scripts/generate-og-pages.ts && bun run scripts/audit-seo.ts",
    "preview": "vite preview",
    "format": "bunx --bun @biomejs/biome format --write ./src",
    "check": "bunx --bun @biomejs/biome check ./src",
    "lint": "bunx --bun @biomejs/biome lint ./src",
    "deploy-page": "bun run build && bun run create-cname && cp dist/index.html dist/404.html && bunx gh-pages -d dist --nojekyll",
    "lint:write": "bunx --bun @biomejs/biome lint --write ./src"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "highlight.js": "^11.11.1",
    "mermaid": "^11.15.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.15.1",
    "rehype-highlight": "^7.0.2",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "purgecss": "^8.0.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.14",
    "vite-plugin-pwa": "^1.3.0"
  }
}

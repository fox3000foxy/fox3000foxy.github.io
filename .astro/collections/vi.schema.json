{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "default": "",
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date-time"
    },
    "lastmod": {
      "type": "string",
      "format": "date-time"
    },
    "readingTime": {
      "type": "number"
    },
    "aiGenerated": {
      "default": false,
      "type": "boolean"
    },
    "tags": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "series": {
      "type": "string"
    },
    "authors": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "author_pubkey": {
      "type": "string"
    },
    "author_sig": {
      "type": "string"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title"
  ]
}
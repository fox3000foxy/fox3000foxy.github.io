# Cloudflare Worker URL (contact form backend)
VITE_CONTACT_API_URL=https://fox-contact.your-subdomain.workers.dev

# Newsletter API (optional, falls back to /api/subscribe)
VITE_NEWSLETTER_API_URL=https://your-newsletter-api.com/subscribe

# Cloudflare Turnstile Site Key (https://dash.cloudflare.com/?to=/:account/turnstile)
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAA...

# Writer Worker URL (article submission backend)
VITE_WRITER_API_URL=https://writer-worker.fox3000foxy.workers.dev
